{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MicroPOV_Episode_Spec",
  "type": "object",
  "required": [
    "episode_id",
    "title",
    "universe",
    "target_duration_sec",
    "pov_config",
    "bgm_plan",
    "scenes"
  ],
  "properties": {
    "episode_id": {
      "type": "string",
      "pattern": "^EP[0-9]{3}$"
    },
    "title": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "universe": {
      "type": "string"
    },
    "mascot": {
      "type": "string"
    },
    "target_duration_sec": {
      "type": "number"
    },
    "render_pipeline": {
      "type": "string",
      "description": "Hybrid Production Pipeline mode: blender_3d (default moving 3D POV), parallax_25d (calm static_object_pov), or ai_i2v (massive historical/nature scale via Google Flow / Veo).",
      "enum": [
        "blender_3d",
        "parallax_25d",
        "ai_i2v"
      ],
      "default": "blender_3d"
    },
    "anchor_mascot": {
      "type": "object",
      "description": "Anchor Opening/Closing framing featuring Mas Dimas for non-human (inside-body or object) episodes.",
      "properties": {
        "opening_sec": { "type": "number" },
        "closing_sec": { "type": "number" },
        "context": { "type": "string" }
      }
    },
    "ending_type": {
      "type": "string",
      "enum": [
        "hard_cut_punchline",
        "seamless_loop",
        "cliffhanger_callback"
      ]
    },
    "silent_readability": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "mute_test_passed": { "type": "boolean" },
            "hook_visual_clue": { "type": "string" },
            "notes": { "type": "string" }
          }
        }
      ]
    },
    "spatial_plan": {
      "type": "object",
      "description": "Pass 2.5 Physical Logic Audit: entry/exit doors, character travel corridor, fixed switch/prop coordinates.",
      "properties": {
        "entry_point": { "type": "string" },
        "destination": { "type": "string" },
        "fixed_landmarks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    },
    "prop_state_chain": {
      "type": "array",
      "description": "Pass 2.5 Causality Chain tracking where each hero prop lives per scene (origin -> worn -> gripped -> dropped).",
      "items": {
        "type": "object",
        "required": ["prop_id", "states"],
        "properties": {
          "prop_id": { "type": "string" },
          "states": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["scenes", "state"],
              "properties": {
                "scenes": { "type": "string" },
                "state": { "type": "string" },
                "parent_bone": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "tts_config": {
      "type": "object"
    },
    "room_tone": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string" },
            "level_db": { "type": "number" },
            "mood": { "type": "string" }
          }
        }
      ]
    },
    "pov_config": {
      "type": "object",
      "required": [
        "subject",
        "camera_height_m",
        "base_fov_deg",
        "visual_style"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "camera_height_m": {
          "type": "number"
        },
        "base_fov_deg": {
          "type": "number"
        },
        "camera_archetype": {
          "type": "string",
          "enum": [
            "insect_ground",
            "aerial_erratic",
            "fluid_float",
            "static_object_pov",
            "human_first_person"
          ]
        },
        "visual_style": {
          "type": "string"
        },
        "hud_or_foreground": {
          "type": "string"
        }
      }
    },
    "bgm_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bgm_id",
          "start_scene",
          "end_scene",
          "mood"
        ],
        "properties": {
          "bgm_id": {
            "type": "string"
          },
          "start_scene": {
            "type": "integer"
          },
          "end_scene": {
            "type": "integer"
          },
          "mood": {
            "type": "string"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "est_duration_sec",
          "vo_text",
          "vo_delivery",
          "camera_motion",
          "visual_action",
          "assets_used",
          "sfx_cues",
          "lighting"
        ],
        "properties": {
          "scene_id": {
            "type": "integer"
          },
          "est_duration_sec": {
            "type": "number"
          },
          "vo_text": {
            "type": "string"
          },
          "vo_delivery": {
            "type": "string"
          },
          "render_pipeline": {
            "type": "string",
            "enum": [
              "blender_3d",
              "parallax_25d",
              "ai_i2v"
            ]
          },
          "camera_archetype": {
            "type": "string",
            "enum": [
              "insect_ground",
              "aerial_erratic",
              "fluid_float",
              "static_object_pov",
              "human_first_person"
            ]
          },
          "motion_modifiers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "snap_jerk",
                "bullet_time",
                "whip_pan",
                "impact_bump",
                "fov_rush",
                "handheld_breath",
                "erratic_wobble",
                "rapid_wing_flutter"
              ]
            }
          },
          "silent_readability": {
            "type": "string"
          },
          "camera_motion": {
            "type": "string"
          },
          "visual_action": {
            "type": "string"
          },
          "assets_used": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sfx_cues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sfx_id",
                "offset_sec"
              ],
              "properties": {
                "sfx_id": {
                  "type": "string"
                },
                "offset_sec": {
                  "type": "number"
                }
              }
            }
          },
          "lighting": {
            "type": "string"
          },
          "on_screen_text": {
            "type": "string"
          }
        }
      }
    }
  }
}