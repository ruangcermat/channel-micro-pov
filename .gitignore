# Python caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Downloaded/generated binary assets (cached in Google Drive / local cache)
02_assets/models_3d/*
!02_assets/models_3d/.gitkeep
02_assets/textures/*
!02_assets/textures/.gitkeep
02_assets/hdri/*
!02_assets/hdri/.gitkeep
02_assets/sfx/*
!02_assets/sfx/.gitkeep
02_assets/bgm/*
!02_assets/bgm/.gitkeep

# Rendered episode outputs & intermediate caches
04_episodes/*/raw_render/
04_episodes/*/output/
04_episodes/*/*.mp4
04_episodes/*/*.wav
04_episodes/*/*.mp3
04_episodes/*/*.ass
04_episodes/*/*.blend
04_episodes/*/*.blend1
04_episodes/*/timing_manifest.json
04_episodes/*/storyboard_grid.png

# Heavy binary media / archives / Blender files anywhere in repo (cached in Google Drive)
*.blend
*.blend1
*.mp4
*.mov
*.wav
*.mp3
*.ogg
*.hdr
*.exr
*.zip
*.tar.xz
*.part*

# OS / editor junk
.DS_Store
Thumbs.db
*.tmp
*.bak

